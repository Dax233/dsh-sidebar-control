{
  "name": "dsh-sidebar-control",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Agent-facing control plane for the DSH right Sidebar: a hierarchical overview of open tabs (browser, terminal, file preview, guide), open/focus/close across tab kinds, and progressive disclosure (expand a tab to pull its content plus the exact tools that act on it).",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "agent",
    "control-plane"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/host.test.mjs tests/client.test.mjs"
  }
}

